NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Account approval is managed in public.app_users; see supabase/approve-user.sql.
